{
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "window.zoomLevel": 2,
  "files.autoSave": "onWindowChange",
  "files.autoSaveDelay": 100,
  "workbench.statusBar.visible": true,
  "terminal.external.osxExec": "iterm.app",
  "typescript.validate.enable": false,
  "files.insertFinalNewline": true,
  "html.format.endWithNewline": true,
  "editor": {
    "bracketPairColorization.enabled": true,
    "defaultFormatter": "esbenp.prettier-vscode",
    "detectIndentation": false,
    "fontFamily": "Fira Code",
    "fontLigatures": true,
    "formatOnPaste": true,
    "formatOnSave": true,
    "insertSpaces": false,
    "minimap.enabled": false,
    "multiCursorModifier": "ctrlCmd",
    "tabSize": 2,
    "wordWrap": "on",
    "codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
    },
    "suggest.showStatusBar": true,
  },
  "vetur.validation.template": false,
  "javascript.validate.enable": false,
  "workbench.editor.showTabs": "multiple",
  "csv-preview.theme": "material",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorCustomizations": {
    "activityBarBadge.background": "#2979FF",
    "activityBar.activeBorder": "#2979FF",
    "list.activeSelectionForeground": "#2979FF",
    "list.inactiveSelectionForeground": "#2979FF",
    "list.highlightForeground": "#2979FF",
    "scrollbarSlider.activeBackground": "#2979FF50",
    "editorSuggestWidget.highlightForeground": "#2979FF",
    "textLink.foreground": "#2979FF",
    "progressBar.background": "#2979FF",
    "pickerGroup.foreground": "#2979FF",
    "tab.activeBorder": "#2979FF",
    "notificationLink.foreground": "#2979FF",
    "editorWidget.resizeBorder": "#2979FF",
    "editorWidget.border": "#2979FF",
    "settings.modifiedItemIndicator": "#2979FF",
    "settings.headerForeground": "#2979FF",
    "panelTitle.activeBorder": "#2979FF",
    "breadcrumb.activeSelectionForeground": "#2979FF",
    "menu.selectionForeground": "#2979FF",
    "menubar.selectionForeground": "#2979FF",
    "editor.findMatchBorder": "#2979FF",
    "selection.background": "#2979FF40",
    "statusBarItem.remoteBackground": "#2979FF",
  },
  "material-icon-theme.activeIconPack": "react",
  "[markdown]": {
    "editor": {
      "quickSuggestions": {
        "comments": "on",
        "strings": "on",
        "other": "on",
      },
    },
  },
  "terminal.integrated.rendererType": "dom",
  "live2d.bottom": -50,
  "live2d.model": "miku",
  "telemetry.enableTelemetry": false,
  "live2d.height": 250,
  "live2d.right": -70,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "git.autofetch": true,
  "prettier.trailingComma": "es5",
  "prettier.useTabs": false,
  "prettier.singleQuote": true,
  "prettier.jsxSingleQuote": true,
  "prettier.jsxBracketSameLine": true,
  "markdown-preview-enhanced.codeBlockTheme": "github.css",
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",
  "sync.gist": "8a623dc83259ef71f0d67dad906cf88f",
  "prettier.semi": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "python.languageServer": "Pylance",
  "materialTheme.accent": "Blue",
  "workbench.startupEditor": "welcomePageInEmptyWorkbench",
  "markdown-pdf.headerTemplate": "<div style=\"font-size: 9px; margin-left: 1cm; display: none\"> <span class='title'></span></div> <div style=\"font-size: 9px; margin-left: auto; margin-right: 1cm; display: none\"> <span class='date'></span></div>",
  "redhat.telemetry.enabled": false,
  "workbench.colorTheme": "GitHub Dark Default",
  "cph.general.defaultLanguage": "python",
  "cph.general.defaultLanguageTemplateFileLocation": "~/.dotfiles/vscode/template.py",
  "cph.general.useShortCodeForcesName": true,
  "focus.highlightRange": "block",
  "svelte.enable-ts-plugin": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
  },
  "diffEditor": {
    "codeLens": true,
    "hideUnchangedRegions.enabled": true,
    "experimental": {
      "showMoves": true,
      "useTrueInlineView": true,
    },
  },
  "errorLens.codeLensEnabled": true,
  "javascript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "python.analysis.inlayHints.callArgumentNames": "all",
  "claudeCode.preferredLocation": "panel",
}
